// SinoLife Sales Intelligence — database schema
//
// DESIGN CONTRACT (read before editing):
//
// 1. EXTERNAL IDENTITY
//    Every entity that can originate from an external CRM carries
//    `externalSource` + `externalId` under a unique composite index.
//    This is what makes synchronisation idempotent: the sync engine upserts
//    on that pair, so re-running a full sync never duplicates rows.
//    Rows created inside this app use externalSource = MANUAL and externalId = null.
//
// 2. MONEY
//    Money is NEVER a float and NEVER a Prisma Decimal.
//    It is stored as BigInt in MINOR UNITS (see src/server/domain/money).
//    For UZS the minor unit is 1/100 so'm. Integer arithmetic stays exact
//    through SUM/AVG aggregation, and it ports across database engines.
//    Field naming convention: any BigInt money column ends in `Minor`.
//
// 3. TIME
//    `*AtSource` columns hold timestamps as reported by the source CRM.
//    `createdAt` / `updatedAt` are OUR row lifecycle, not the deal's.
//    Analytics must use the *AtSource columns — otherwise a re-sync would
//    silently move every deal into the current reporting period.
//
// 4. STAGE SEMANTICS
//    `DealStage.category` is OUR normalised meaning (NEW/IN_PROGRESS/WON/LOST).
//    Bitrix24 stage IDs get mapped onto it by configuration, never hardcoded.
//    Analytics reads `category` and `Deal.status`, never a stage name.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Where a record came from. Drives the "Demo data" badge in the UI and
/// guarantees demo rows can never be mistaken for live Bitrix24 rows.
enum ExternalSource {
  DEMO
  BITRIX24
  MANUAL
}

enum Role {
  ADMIN
  MANAGER
  SALES
}

/// How many rows an account may read, independently of which screens it holds.
///
/// The two questions used to be answered by one field. `role` said both "may
/// this person administer anything" and "how much data do they see", so the
/// only way to give somebody the whole company's numbers was to make them a
/// manager, and the only way to make them read-only was to blind them. This
/// splits them: `role` is what an account may CHANGE, `sections` is which
/// screens it may open, `dataScope` is how much of each it may read.
enum DataScope {
  /// Everything the granted sections cover, company-wide.
  ALL
  /// The linked employee's own unit and everything under it. Requires `employeeId`.
  ///
  /// What a ROP is given. The client's own request: «ROP Asliddin bersam shu
  /// faqat uzini malumotlarini korishi kerak umumiy emas» — a team head who
  /// opens the confirmation queue or the sellers board must read their own
  /// floor, not the company's. Resolved from the department tree, never
  /// stored: the units this person's record is anchored to (their primary
  /// department and any department they HEAD) plus every department beneath
  /// them, then everyone whose primary department is one of those.
  ///
  /// PRIMARY membership, not `department_member`. A person is credited to one
  /// unit for money and listed in several for the org chart, and this decides
  /// which rows a reader may see — a money question. Widening it to every
  /// membership would put a borrowed operator's orders on two ROPs' boards.
  TEAM
  /// Only the linked employee's own records. Requires `employeeId`.
  OWN
}

/// What a pipeline is FOR. Only REVENUE contributes to money figures.
///
/// The portal runs nine pipelines and only two of them are sales. Naming the
/// role explicitly means an analytics module can say "the retention pipeline"
/// instead of hardcoding CATEGORY_ID = 10, and a pipeline can be reclassified
/// with one UPDATE instead of a redeploy.
enum PipelineRole {
  /// Доставка (#6), Ecommerce (#14). Counts toward revenue, conversion, KPI.
  REVENUE
  /// База (#10) — repeat-contact cycle. A confirmed duplicate of Доставка's
  /// money, so it is imported and browsable but never counted.
  RETENTION
  /// Тасдиклаш (#4) — order confirmation calls.
  CONFIRMATION
  /// Первичный отдел (#12) — lead qualification.
  QUALIFICATION
  /// Регистрация (#0) — raw inbound registration.
  LEAD
  /// ИИ обработка (#20) — automated triage.
  AI_TRIAGE
  /// HR (#8), Бахолаш (#18). Present for reference, in no aggregate.
  IGNORED
}

/// A stage's place in the delivery ladder of the Доставка pipeline.
///
/// Bitrix24 returns SEMANTICS only for WON and LOSE; the other sixteen stages
/// come back null. This is our classification of them, and it is what the
/// logistics module measures. Assigned in the provider's mapping file.
enum LogisticsRole {
  /// Подготовка товара, Обработка заказов.
  PREPARING
  /// Заказ в мой склад.
  WAREHOUSE
  /// Тасдиклаш · Заказ тасдиклаш — in the confirmation queue, not yet worked.
  PENDING_CONFIRM
  /// Тасдиклаш · Сделка успешна — an operator reached the customer and confirmed.
  CONFIRMED
  /// Доставка · Успешно заказ — a post-delivery settlement stamp, NOT a
  /// confirmation. It is written by automation within five seconds of
  /// Доставлено in two thirds of cases; treating it as CONFIRMED made the
  /// whole confirmation module a second copy of the delivery rate.
  SETTLED
  /// В пути.
  IN_TRANSIT
  /// TOSHKENT-1, NAVOIY, VODIY, QASHQADARYO, SURXONDARYO.
  REGIONAL_HUB
  /// CARAVAN, OSON POCHTA, BEK POCHTA.
  CARRIER
  /// Юрист смс, Пропущенный.
  CHASING
  /// Доставлено.
  DELIVERED
  /// Отказ — refused after dispatch.
  REFUSED
  /// Отказ предварительно — cancelled before dispatch. A different number
  /// from REFUSED and must never be merged with it.
  CANCELLED_EARLY
}

/// Operator confirmation outcome — UF_CRM_1777879395123 on the deal.
/// What a stage move tells the confirmation queue, and nothing else.
///
/// The client's bot reacts to exactly five stages; every other stage in the
/// three tracked funnels leaves the order's confirmation status untouched.
/// Their infrastructure document is explicit about it ("IGNORED: ... статус
/// ўзгармайди"), and the distinction matters: an order parked in «Пропущенный»
/// has not been reached and has not refused — it is still whatever it was.
///
/// UNCONFIRMED_SHIPPED is absent on purpose. It is not a property of a stage:
/// arriving in `C6:NEW` is CONFIRMED unless the deal's «Тастиклаш анализ»
/// field says the customer was never reached, which is a fact about the deal.
enum ConfirmationSignal {
  CONFIRM_NEW
  NO_ANSWER
  REJECTED
  CONFIRMED
}

enum ConfirmStatus {
  /// Тастикланган
  CONFIRMED
  /// Недозвон булиб чикарилган
  UNREACHABLE
}

enum CallDirection {
  INBOUND
  OUTBOUND
  CALLBACK
}

/// Our normalised stage meaning. Bitrix24 stage IDs map ONTO this.
enum StageCategory {
  NEW
  IN_PROGRESS
  WON
  LOST
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum KpiMetric {
  REVENUE
  DEALS_CREATED
  DEALS_WON
  AVERAGE_DEAL
  CONVERSION_RATE
}

enum KpiPeriod {
  MONTH
  QUARTER
  YEAR
}

enum KpiStatus {
  ACHIEVED
  ON_TRACK
  AT_RISK
  BEHIND
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum SyncEntity {
  DEPARTMENTS
  EMPLOYEES
  PRODUCT_CATEGORIES
  PRODUCTS
  PIPELINES
  STAGES
  SOURCES
  CUSTOMERS
  DEALS
  DEAL_ITEMS
  PAYMENTS
  STAGE_HISTORY
  CALLS
  STORES
  STOCK
}

enum SyncMode {
  FULL
  INCREMENTAL
}

enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/// The twelve slices the Roistat blob publishes, one array each.
///
/// These are OUR names for the source's own tab ids, and the mapping is
/// one-to-one and case-only — lowercase the enum value and you have the id the
/// published page uses in `D.dims`, `D.tabs[].id` and the module's `?dimension=`
/// query parameter:
///
///   CAMP camp · ADSET adset · CREATIVE creative · TARGETOLOG targetolog
///   FORM form · SOURCE source · PRODUCT product · REGION region · ROP rop
///   SELLER seller · REGISTRATOR registrator · DAYS days
///
/// CAMP → ADSET → CREATIVE is the only nesting: an ADSET row's `parent` is its
/// campaign key, a CREATIVE row's `parent` is its adset key. Every other
/// dimension is flat and stores an empty parent.
enum MarketingDimension {
  CAMP
  ADSET
  CREATIVE
  TARGETOLOG
  FORM
  SOURCE
  PRODUCT
  REGION
  ROP
  SELLER
  REGISTRATOR
  DAYS
}

// ---------------------------------------------------------------------------
// Authentication (better-auth owns the shape of these six models)
// ---------------------------------------------------------------------------

model User {
  id            String  @id @default(cuid())
  name          String
  /// Login name, set by an administrator. What people actually type.
  ///
  /// Normalised to lower case by the username plugin; `displayUsername` keeps
  /// the casing the administrator typed. Nullable because the founding
  /// administrator predates this column and still signs in by email.
  username        String? @unique
  displayUsername String?
  /**
   * Still the account's unique key inside better-auth, and still required.
   *
   * For an account created by login name there is no real mailbox, so one is
   * synthesised as `<login>@sinolife.local`. Nobody sees it or types it — it
   * exists because better-auth's user table demands a unique email and because
   * a future password-reset flow would need somewhere to put a real address.
   */
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  /// Owned by the two-factor plugin, not by us.
  ///
  /// False until a TOTP secret has been enrolled AND proved with a live code,
  /// which is what keeps 2FA opt-in: every existing account carries the
  /// default and signs in exactly as it did before the plugin arrived. The
  /// plugin declares it `input: false`, so no request body can set it.
  twoFactorEnabled Boolean @default(false)

  // Application fields (exposed to better-auth via additionalFields)
  role       Role    @default(SALES)
  isActive   Boolean @default(true)
  /// Which dashboard sections this account may open, by section id.
  ///
  /// EMPTY MEANS "not configured", never "denied everything" — the account
  /// falls back to its role's default set, so every user that predates this
  /// column keeps exactly the access it had. See src/lib/sections.ts.
  ///
  /// Sections only ever NARROW the role: a SALES account granted `finance`
  /// still cannot read finance, because the endpoint checks the role's
  /// permission first and SALES has none.
  sections   String[] @default([])
  /// How much of each granted section this account reads.
  ///
  /// ALL by default, because an account an administrator has just created and
  /// handed screens to is meant to SEE those screens. The previous default
  /// was implied by the role, and it silently produced accounts that opened
  /// every page they were given and found every figure blank.
  ///
  /// OWN and TEAM are only meaningful with `employeeId` set; the service
  /// refuses either combination without it rather than storing a scope that
  /// resolves to nothing.
  dataScope  DataScope @default(ALL)
  /// The salesperson this login belongs to. Required for `dataScope = OWN` and
  /// for `TEAM`, where it is enforced in the repository layer, never by hiding
  /// UI. Under TEAM it is also the anchor the department subtree is grown from.
  employeeId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sessions  Session[]
  accounts  Account[]
  twoFactor TwoFactor[]
  auditLogs AuditLog[]

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  /// Authentication method, e.g. "credential".
  providerId            String
  /// Identity namespace, e.g. "local:credential" for email+password.
  /// better-auth matches the sign-in account on (issuer, accountId), not on
  /// providerId alone — an account row without it can never be signed into.
  issuer                String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Hashed credential for the email/password provider. Never plaintext.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@index([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// The second factor. One row per user who has enrolled an authenticator app.
///
/// Shape dictated by better-auth's `twoFactor` plugin
/// (node_modules/better-auth/dist/plugins/two-factor/schema.mjs); the field
/// names must match or the adapter writes to columns that do not exist.
///
/// A ROW EXISTING IS NOT THE SAME AS 2FA BEING ON. `/two-factor/enable`
/// creates this row with `verified = false` and leaves `user.twoFactorEnabled`
/// alone. Only a correct code posted to `/two-factor/verify-totp` flips both.
/// That gap is the whole safety of the enrolment flow: the backup codes are
/// handed over in the enable response, and if the person walks away without
/// saving them, nothing has been armed and they can still sign in with the
/// password alone.
///
/// `onDelete: Cascade` — deleting the user must not leave an orphaned secret.
model TwoFactor {
  id String @id @default(cuid())

  /// The TOTP seed, AES-encrypted under BETTER_AUTH_SECRET before it is
  /// written. A database dump therefore does not hand over the second factor;
  /// rotating BETTER_AUTH_SECRET, on the other hand, makes every enrolled
  /// authenticator unreadable and forces a re-enrolment.
  ///
  /// The plugin's schema marks this `index: true`. We deliberately do not
  /// index it: nothing ever queries by secret (every lookup is by `userId`),
  /// so the index would buy nothing and put a searchable structure over the
  /// most sensitive column in the database.
  secret String

  /// The remaining single-use recovery codes, as an encrypted JSON array.
  /// Verifying one rewrites this column with that code removed.
  backupCodes String

  userId String

  /// False between "enable" and the first correct code. A sign-in challenge
  /// refuses an unverified secret, so a half-finished enrolment can never
  /// become the thing standing between the owner and their data.
  verified Boolean @default(true)

  /// Consecutive failed second-factor verifications, and the lock they earn.
  /// Enforced inside the plugin (`accountLockout`), stored here so a deploy —
  /// which restarts the process — does not reset an attacker's budget.
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor")
}

/// Sign-in failure budget, keyed by a hash of the email that was tried.
///
/// Rate limiting caps how FAST someone can guess. It does nothing about how
/// LONG they are willing to guess: five attempts a minute, kept up quietly for
/// a week, is fifty thousand tries. This table is the second half of the
/// answer — after `MAX_FAILED_SIGN_INS` consecutive failures the account stops
/// answering at all for a while, and the wait grows each time the budget is
/// spent again.
///
/// WHY THE KEY IS A HASH OF THE EMAIL, NOT A USER ID.
/// Two reasons, and the first one is the important one:
///
///  1. An address with no account has to be able to lock too. If only real
///     users could be locked, then "too many attempts" would be a yes/no
///     oracle for "does this address have an account here" — the exact
///     disclosure the login page's deliberately vague error avoids.
///  2. This table is then not a list of who has an account. A dump of it
///     yields opaque digests, not a target list.
///
/// Rows for addresses nobody will ever try again are pruned on write (see
/// `lockout.ts`), so a guesser cycling through addresses cannot grow the table
/// without bound.
model SignInLockout {
  /// SHA-256 (hex) of the lowercased, trimmed email. Never the email itself.
  emailHash String @id

  /// Consecutive failures. Reset to zero by a successful sign-in, and treated
  /// as zero once `lastFailedAt` is older than the decay window.
  failedCount Int @default(0)

  /// While this is in the future, sign-in is refused before the password is
  /// even checked.
  lockedUntil DateTime?

  lastFailedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Pruning scans by age, not by key.
  @@index([lastFailedAt])
  @@map("sign_in_lockout")
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

/// The company tree, as Bitrix24 reports it via department.get.
///
/// The portal's structure is three deep — NEWGEN → region → ROP group — and
/// the org chart is unusable flattened, so the parent link is modelled rather
/// than kept in metadata. `headId` is resolved from UF_HEAD in a second pass,
/// because a department's head is an employee whose own department may not
/// exist yet on the first pass.
model Department {
  id             String         @id @default(cuid())
  externalSource ExternalSource @default(MANUAL)
  externalId     String?
  name           String
  parentId       String?
  headId         String?
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentTree")
  head      Employee?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  employees Employee[]
  /// Everyone the portal lists in this unit, including people whose PRIMARY
  /// unit is another one. See DepartmentMember.
  members   DepartmentMember[]

  @@unique([externalSource, externalId])
  @@index([isActive])
  @@index([parentId])
  @@map("department")
}

model Employee {
  id             String         @id @default(cuid())
  externalSource ExternalSource @default(MANUAL)
  externalId     String?
  fullName       String
  email          String?
  phone          String?
  position       String?
  departmentId   String?
  avatarUrl      String?
  isActive       Boolean        @default(true)
  hiredAt        DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user       User?
  deals      Deal[]
  /// Deals this person SOLD, as the portal's own snapshot names them — which is
  /// not the same set as `deals`, the ones they own today. See Deal.operatorEmployeeId.
  soldDeals  Deal[]      @relation("DealOperator")
  kpis       Kpi[]
  calls      CallRecord[]
  heads      Department[] @relation("DepartmentHead")
  /// Every unit this person belongs to. `departmentId` above is only the first
  /// of them. See DepartmentMember.
  memberships DepartmentMember[]

  @@unique([externalSource, externalId])
  @@index([departmentId])
  @@index([isActive])
  @@index([fullName])
  @@map("employee")
}

/// Which units a person belongs to — all of them.
///
/// `UF_DEPARTMENT` is an ARRAY in Bitrix24, and the portal's own org chart
/// counts a person once in EVERY unit it names. Nine of this portal's 208
/// active people sit in two units at once, so reading only the first entry
/// under-counted five of the twenty cards by one or two against the screen
/// they are meant to reproduce: Тошкент онлайн 0 against 1, Asliddin(ROP) 8
/// against 10, Azizbek(ROP) 14 against 16, Saidaziz(ROP) 14 against 15,
/// Sevinchxon(ROP) 8 against 10.
///
/// `Employee.departmentId` STAYS the primary membership and keeps its meaning:
/// every analytic on this dashboard credits a person to exactly one unit, and
/// rolling a two-unit person up both branches would count their headcount, and
/// their money, twice. This table answers the other question — "who does the
/// portal list here" — and nothing but the org chart reads it.
model DepartmentMember {
  departmentId String
  employeeId   String
  /// True for the first entry of UF_DEPARTMENT — the one `Employee.departmentId`
  /// also points at. Kept so the two representations can be reconciled without
  /// re-reading the portal.
  isPrimary    Boolean @default(false)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([departmentId, employeeId])
  @@index([employeeId])
  @@map("department_member")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model ProductCategory {
  id             String         @id @default(cuid())
  externalSource ExternalSource @default(MANUAL)
  externalId     String?
  name           String
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  products Product[]

  @@unique([externalSource, externalId])
  @@map("product_category")
}

model Product {
  id             String         @id @default(cuid())
  externalSource ExternalSource @default(MANUAL)
  externalId     String?
  name           String
  sku            String?
  categoryId     String?
  /// List price in minor units. Null when the source does not publish one.
  priceMinor     BigInt?
  /// Purchase price in minor units — the COGS basis for gross margin.
  ///
  /// Null until the `catalog` scope is granted on the webhook. Null means
  /// UNKNOWN, never zero: a margin computed against a zero cost reads as 100%
  /// and is worse than no margin at all. Every margin query must exclude rows
  /// where this is null and report the excluded share.
  costMinor      BigInt?
  currency       String         @default("UZS") @db.Char(3)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  category  ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dealItems DealItem[]
  stock     StockLevel[]

  @@unique([externalSource, externalId])
  @@index([categoryId])
  @@index([isActive])
  @@index([name])
  @@map("product")
}

model Customer {
  id             String         @id @default(cuid())
  externalSource ExternalSource @default(MANUAL)
  externalId     String?
  name           String
  /// True when the counterparty is a company rather than an individual.
  isCompany      Boolean        @default(false)
  email          String?
  /// The first number, kept as the one every existing query already reads.
  phone          String?
  /// EVERY number Bitrix24 holds for this contact, in the portal's own order.
  ///
  /// A contact routinely carries two — a mobile and a landline, or the buyer
  /// and whoever actually answers. Importing only PHONE[0] meant an operator
  /// looking at the queue saw one number and had no idea a second existed,
  /// which on a confirmation desk is a call that never gets made.
  phones         String[]       @default([])
  region         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  deals Deal[]
  calls CallRecord[]

  @@unique([externalSource, externalId])
  @@index([name])
  @@map("customer")
}

// ---------------------------------------------------------------------------
// Pipeline
// ---------------------------------------------------------------------------

/// A Bitrix24 deal category (воронка). Nine of them exist.
///
/// Which ones count as revenue is a business decision, so it lives in DATA.
/// Reclassifying Доставка is one UPDATE plus a re-sync — not a code change.
model Pipeline {
  id             String         @id @default(cuid())
  externalSource ExternalSource @default(MANUAL)
  externalId     String?
  name           String
  role           PipelineRole   @default(IGNORED)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  deals  Deal[]
  stages DealStage[]

  @@unique([externalSource, externalId])
  @@index([role])
  @@map("pipeline")
}

model DealStage {
  id             String         @id @default(cuid())
  externalSource ExternalSource @default(MANUAL)
  externalId     String?
  name           String
  /// Normalised meaning used by every analytics function.
  category       StageCategory
  /// Which funnel this stage belongs to. Stage IDs repeat across pipelines
  /// (C6:WON and C14:WON are different stages), so a stage without its
  /// pipeline is ambiguous.
  pipelineId     String?
  /// Place in the delivery ladder. Set only for Доставка stages.
  logisticsRole  LogisticsRole?
  /// What entering this stage says about the order's confirmation.
  ///
  /// Null for all but five stages, which is the point — see ConfirmationSignal.
  confirmationSignal ConfirmationSignal?
  /// Funnel ordering. Lower numbers sit earlier in the pipeline.
  sortOrder      Int
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  pipeline Pipeline?          @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  deals    Deal[]
  history  DealStageHistory[]

  @@unique([externalSource, externalId])
  @@index([category])
  @@index([sortOrder])
  @@index([pipelineId])
  @@index([logisticsRole])
  @@index([confirmationSignal])
  @@map("deal_stage")
}

model SalesSource {
  id             String         @id @default(cuid())
  externalSource ExternalSource @default(MANUAL)
  externalId     String?
  name           String
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  deals   Deal[]
  adSpend AdSpend[]

  @@unique([externalSource, externalId])
  @@map("sales_source")
}

model Deal {
  id             String         @id @default(cuid())
  externalSource ExternalSource @default(MANUAL)
  externalId     String?

  title       String
  /// Deal value in minor units. See money contract at the top of this file.
  amountMinor BigInt @default(0)
  currency    String @default("UZS") @db.Char(3)

  stageId    String
  status     DealStatus @default(OPEN)
  employeeId String
  customerId String?
  sourceId   String?
  pipelineId String?

  /// Order code parsed from TITLE when it matches ^bx\d+$.
  ///
  /// This is the key that proved База duplicates Доставка, and the only way to
  /// link a delivered order to its retention copy afterwards.
  orderCode String?

  /// Denormalised from the pipeline's role at import time.
  ///
  /// Deliberately redundant with pipeline.role, and the redundancy IS the
  /// point: a forgotten join silently pulls 13 474 duplicate База deals into
  /// revenue and the result looks entirely plausible. A column every analytics
  /// query must name explicitly fails loudly instead.
  countsAsRevenue Boolean @default(false)

  // -- Bitrix24 custom fields, promoted out of `metadata` because analytics
  //    filters on them. Null always means the portal left them empty.

  /// UF_CRM_1747975214161 — one of 14 regions.
  region           String?
  /// UF_CRM_1756494336 — warehouse, courier or marketplace that fulfils it.
  fulfilmentPoint  String?
  /// UF_CRM_1748964117765 — delivery address, free text as the operator typed it.
  deliveryAddress  String?
  /// UF_CRM_1777879395123 — operator confirmation outcome.
  confirmStatus    ConfirmStatus?
  /// UF_CRM_1770109073790 — why the customer refused.
  refusalReason    String?
  /// UF_CRM_1747979729184 — карта / накд / консультация, as the operator set it.
  paymentMethodRaw String?
  /// UF_CRM_1750413928942 — Collagen Marine / Zextra sure / Sinolife collagen.
  productLine      String?
  /// UF_CRM_1747979663403 — A / B / C grade.
  customerGrade    String?
  /// UF_CRM_1778416910 «Фамилия имя ответсвенный» — THE SELLER, as the portal's
  /// own automation stamped them at the moment of sale, e.g. «Davlatbek Sirojov
  /// 115». NOT the same person as `employeeId`, which is the deal's owner TODAY:
  /// this portal reassigns deals to back office during processing, and in July
  /// 2026 that put 556 orders on the head of Операцион and made him the sellers
  /// board's number one. The client's own board ranks by this field.
  operatorNameSource String?
  /// UF_CRM_1778416806 «Организация сотрудника» — that operator's ROP team at
  /// the TIME OF SALE, e.g. «Sevinch(ROP)». Deliberately historic: one July row
  /// reads «Husniddin(ROP)», a department the portal no longer has.
  operatorTeamSource String?
  /// `operatorNameSource` resolved to one of our people at import, by the floor
  /// number both spellings share — «Davlatbek Sirojov 115» in the portal is
  /// «Sirojov 115 Davlatbek» here. NULL when the field was empty (July 20%,
  /// August 10%) or the badge is ambiguous, and every reader must then fall
  /// back to `employeeId`. See domain/employees/floorNumber.
  operatorEmployeeId String?
  /// IS_RETURN_CUSTOMER — Bitrix24's own repeat-purchase flag.
  isReturnCustomer Boolean        @default(false)

  /// Timestamps as reported by the source CRM. Analytics uses THESE.
  createdAtSource DateTime
  updatedAtSource DateTime?
  closedAt        DateTime?

  /// Source fields we do not model explicitly yet. Populated by the mapping
  /// layer so no Bitrix24 data is lost before its mapping is confirmed.
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stage        DealStage          @relation(fields: [stageId], references: [id], onDelete: Restrict)
  pipeline     Pipeline?          @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// SetNull, not Restrict: this is a denormalised convenience, and a deleted
  /// employee must not block the delete of a row that still has a real owner.
  operatorEmployee Employee?       @relation("DealOperator", fields: [operatorEmployeeId], references: [id], onDelete: SetNull)
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  source       SalesSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  items        DealItem[]
  payments     Payment[]
  stageHistory DealStageHistory[]
  calls        CallRecord[]

  @@unique([externalSource, externalId])
  // Composite indexes chosen to match the actual analytics access patterns:
  // "deals for employee X in period P" and "won deals closed in period P".
  @@index([employeeId, createdAtSource])
  /// The sellers board and the confirmation queue both group by the resolved
  /// operator, so it is looked up per cohort row.
  @@index([operatorEmployeeId])
  @@index([status, closedAt])
  @@index([createdAtSource])
  @@index([stageId])
  @@index([sourceId])
  @@index([customerId])
  @@index([pipelineId])
  @@index([orderCode])
  // Every revenue query names countsAsRevenue first, so it leads the index.
  @@index([countsAsRevenue, status, closedAt])
  @@index([countsAsRevenue, region, closedAt])
  @@index([confirmStatus, createdAtSource])
  @@map("deal")
}

/// One row per stage transition, from crm.stagehistory.list.
///
/// The basis for every duration in the product: delivery SLA, time to
/// confirmation, time in each hub. Durations are NEVER computed by subtracting
/// a deal's create date from its close date — that answers a different
/// question and is wrong for anything that moved through more than one stage.
model DealStageHistory {
  id             String         @id @default(cuid())
  externalSource ExternalSource @default(BITRIX24)
  externalId     String
  dealId         String
  stageId        String
  enteredAt      DateTime
  /// Filled from the deal's NEXT transition when the history is written.
  /// Null means the deal is still sitting in this stage.
  leftAt         DateTime?
  createdAt      DateTime       @default(now())

  deal  Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  stage DealStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  @@unique([externalSource, externalId])
  @@index([dealId, enteredAt])
  @@index([stageId, enteredAt])
  @@map("deal_stage_history")
}

/// Telephony, from voximplant.statistic.get.
///
/// `transcript` and `score` exist and stay null. Call quality scoring is not
/// built, but the recordings it would need are collected from day one, so
/// adding a scorer later is a job that reads this table rather than a
/// twelve-month gap in the data.
model CallRecord {
  id             String         @id @default(cuid())
  externalSource ExternalSource @default(BITRIX24)
  externalId     String
  employeeId     String?
  customerId     String?
  dealId         String?
  direction      CallDirection
  phoneNumber    String?
  startedAt      DateTime
  durationSec    Int            @default(0)
  /// A call that actually connected. Bitrix24 reports 200 in CALL_FAILED_CODE
  /// for these; anything else is a failure with the code kept below.
  connected      Boolean        @default(false)
  failedCode     String?
  recordUrl      String?
  transcript     String?
  score          Int?
  createdAt      DateTime       @default(now())

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deal     Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@unique([externalSource, externalId])
  @@index([employeeId, startedAt])
  @@index([dealId])
  @@index([startedAt])
  @@map("call_record")
}

model DealItem {
  id             String         @id @default(cuid())
  externalSource ExternalSource @default(MANUAL)
  externalId     String?

  dealId         String
  productId      String
  quantity       Int    @default(1)
  /// Unit price actually charged on this deal, in minor units.
  unitPriceMinor BigInt
  /// Denormalised line total. Kept so product analytics can aggregate in SQL
  /// without recomputing quantity * price per row.
  totalMinor     BigInt
  /// Discount given away on this line, in minor units.
  ///
  /// Some rows in the portal carry DISCOUNT_RATE 100 — a full giveaway. Those
  /// destroy margin silently unless they are visible, so the discount is a
  /// column rather than something reconstructed from price differences.
  discountMinor  BigInt @default(0)
  /// Discount rate in basis points. 10.11% arrives as 1011.
  discountRateBp Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([externalSource, externalId])
  @@index([dealId])
  @@index([productId])
  @@map("deal_item")
}

// ---------------------------------------------------------------------------
// Finance
//
// BITRIX24_INTEGRATION_PENDING
// The structure below is our own model of payment tracking. Whether Bitrix24
// exposes these fields, and under which names, is NOT yet confirmed. Until the
// real field mapping arrives, the Bitrix24 provider returns no payments and
// the API reports financial figures as unavailable rather than as zero.
// See docs/BITRIX24.md.
// ---------------------------------------------------------------------------

model Payment {
  id             String         @id @default(cuid())
  externalSource ExternalSource @default(MANUAL)
  externalId     String?

  dealId      String
  amountMinor BigInt
  currency    String        @default("UZS") @db.Char(3)
  paidAt      DateTime
  method      PaymentMethod @default(BANK_TRANSFER)
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([externalSource, externalId])
  @@index([dealId])
  @@index([paidAt])
  @@map("payment")
}

// ---------------------------------------------------------------------------
// Warehouse
//
// Fed by catalog.store.list and catalog.storeproduct.list, which need the
// `catalog` scope on the webhook. Until it is granted these tables stay empty
// and the warehouse endpoint reports the missing scope rather than showing an
// empty shelf, which would read as "we have nothing in stock".
// ---------------------------------------------------------------------------

model Store {
  id             String         @id @default(cuid())
  externalSource ExternalSource @default(MANUAL)
  externalId     String?
  name           String
  address        String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  stock StockLevel[]

  @@unique([externalSource, externalId])
  @@index([isActive])
  @@map("store")
}

/// On-hand quantity for one product in one store.
///
/// Quantity is Decimal, not BigInt-minor: this is a count of physical units,
/// not money, and the portal reports fractional quantities for weighed goods.
/// The money contract at the top of this file applies to money only.
model StockLevel {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  quantity  Decimal  @default(0) @db.Decimal(14, 3)
  reserved  Decimal  @default(0) @db.Decimal(14, 3)
  /// When this row was last refreshed from the portal. Stock is a snapshot,
  /// not a history, so a stale row must be visibly stale.
  syncedAt  DateTime @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([productId])
  @@map("stock_level")
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------

/// Advertising spend per channel per month, entered by hand.
///
/// The portal knows where a deal came from but not what it cost to get it, and
/// there is no Roistat account to ask. This table is the only writable
/// business data in the application: with a row, the channel page reports CPL,
/// CPO, CAC and ROI; without one it reports volume and conversion and says the
/// spend is not entered. It never guesses a cost.
model AdSpend {
  id          String   @id @default(cuid())
  sourceId    String
  /// First day of the month the spend belongs to, in Asia/Tashkent.
  periodStart DateTime @db.Date
  amountMinor BigInt
  currency    String   @default("UZS") @db.Char(3)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  source SalesSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, periodStart])
  @@index([periodStart])
  @@map("ad_spend")
}

// ---------------------------------------------------------------------------
// Marketing · Roistat
//
// A SECOND LEDGER, DELIBERATELY NOT JOINED TO THE FIRST.
//
// Everything above this block comes from Bitrix24. These two tables do not.
// A live probe of the portal (2026-08-27) found no Roistat fields, sources,
// apps or smart processes at all: the client's marketing numbers live in their
// own Google Sheets (working + archive) plus Meta Ads, published as a static
// `var D = {...}` blob on a GitHub Pages dashboard, and `scripts/importRoistat`
// copies that blob in verbatim.
//
// So there is no relation from MarketingDaily to Deal, Employee, Product or
// SalesSource, and there must never be one. The two systems measure overlapping
// things by different rules — Roistat attributes collected money to the LEAD's
// date, Bitrix24 books a won deal on its close date — and a foreign key would
// invite exactly the join that turns one company's revenue into two. Where the
// numbers can be compared they are compared side by side and the divergence is
// shown, by `scripts/verifyRoistat.ts` and the module's cross-check panel.
//
// CURRENCY, WHICH IS NOT UNIFORM HERE.
// The source mixes two currencies in one row and so do we, because converting
// on import would freeze today's rate into history:
//   - `spendMicroUsd` is USD in MICRO units (1e6 per dollar). It is the one
//     BigInt money column in this schema that does not end in `Minor`, and the
//     name says why: ad spend arrives with cents (80.36) from Meta, and the
//     module divides it by leads, by sales, by 1000 impressions. Micro keeps
//     those quotients honest and the `MicroUsd` suffix makes a wrong unit a
//     compile-time-visible mistake rather than a silent 1 000 000x.
//   - `orderedMinor`, `soldMinor`, `metaRevenueMinor` are UZS minor units
//     (1/100 soʻm), the same contract as every other `Minor` column.
// ROAS therefore reads (soldMinor / 100 / rate) / (spendMicroUsd / 1e6) — the
// UZS side is converted first, never the USD side. Getting that backwards is
// the single easiest way to be wrong about this data.
// ---------------------------------------------------------------------------

/// One dimension value, on one day, with the sixteen additive counters the
/// published blob carries for it. One row per `{d, k, p}` tuple in `D.dims`.
///
/// Every column here is ADDITIVE: the whole module aggregates by plain
/// summation and derives its rates afterwards (qual, CPL, buyout, ROAS…).
/// Nothing pre-averaged is stored, because a stored average cannot be re-summed
/// over a different window without lying.
///
/// The dimensions do not share a date range and that gap is real data, not a
/// defect to paper over: camp/adset/creative/days run to the blob's `today`
/// while the sheet-fed dimensions stop days earlier. The importer replaces only
/// the range each dimension actually covers, so a short dimension never wipes
/// the days a longer one still holds.
model MarketingDaily {
  id String @id @default(cuid())

  /// The reporting day, as the source states it. A bare date, not an instant:
  /// the blob has no times and no timezone, and widening it to a timestamp
  /// would invent an hour that would then get bucketed in Asia/Tashkent and
  /// shift the row.
  date      DateTime           @db.Date
  dimension MarketingDimension
  /// The dimension value verbatim from the sheet — a campaign name, a region,
  /// a seller's name, or for DAYS the ISO date repeated. Never normalised on
  /// import: these are the strings the client typed, and the cross-check with
  /// Bitrix24 needs to see them exactly as they were typed to report honestly
  /// on which ones failed to match.
  key       String
  /// Parent value for the drill-down chain, EMPTY STRING when there is none.
  ///
  /// Not nullable, on purpose. Postgres treats NULLs as distinct inside a
  /// unique index, so a nullable parent would let the same
  /// {dimension, date, key} land twice and quietly break both the upsert and
  /// the idempotency of the import. The source blob already writes `p: ""` for
  /// flat dimensions, so the empty string is its own convention, not ours.
  parent    String             @default("")

  // -- Lead funnel (counts) -------------------------------------------------
  /// `leads` — leads received.
  leads        Int @default(0)
  /// `clean` — "чистые": leads left after junk is removed. Numerator of Sifat.
  clean        Int @default(0)
  /// `kval` — qualified leads. Numerator of QL %.
  kval         Int @default(0)
  /// `orders` — order count. Its money counterpart is `orderedMinor`.
  orders       Int @default(0)
  /// `sold` — completed sales count. Its money counterpart is `soldMinor`.
  sold         Int @default(0)
  /// `newc` — new customers, the denominator of CAC.
  newCustomers Int @default(0)

  // -- Money ---------------------------------------------------------------
  /// `spend` — ad spend in USD micro units (1e6 per dollar). See the block
  /// comment above: this is the only non-`Minor` money column in the schema.
  spendMicroUsd    BigInt @default(0)
  /// `fact1` — amount ORDERED ("Заказы"), UZS minor units.
  orderedMinor     BigInt @default(0)
  /// `fact2` — amount SOLD/collected ("Продажи"), UZS minor units. This is the
  /// revenue ROAS, buyout rate, average cheque and ARPL are all built on.
  soldMinor        BigInt @default(0)
  /// `mrev` — the slice of `soldMinor` Meta claims attribution for, UZS minor.
  metaRevenueMinor BigInt @default(0)

  // -- Deal time -----------------------------------------------------------
  /// `dsum` / `dcnt` — day-sum and count behind "Deal Time" (lead → sale).
  /// Both are zero in every row the source publishes today, which is why the
  /// tile renders an em dash rather than 0 kun. Stored anyway: the day the
  /// sheet starts filling them the module needs no migration.
  dealDaysSum Int @default(0)
  dealCount   Int @default(0)

  // -- Meta Ads delivery ---------------------------------------------------
  /// BigInt, not Int: impressions run to 46 million over eight weeks on this
  /// account alone and a yearly window has room to pass 2^31.
  impressions BigInt @default(0)
  reach       BigInt @default(0)
  clicks      BigInt @default(0)
  /// `mleads` — leads as META counts them, which is not what `leads` counts.
  /// Kept separate so the discrepancy stays visible.
  metaLeads   Int    @default(0)

  /// When this row was last written by the importer. The blob's own freshness
  /// lives on MarketingSnapshot; this is our row lifecycle.
  importedAt DateTime @default(now())

  /// The import key. Delete-then-insert per covered range makes the import
  /// idempotent, and this constraint is what guarantees the blob cannot
  /// contribute the same cell twice.
  @@unique([dimension, date, key, parent])
  /// The drill-down read: adsets of one campaign, creatives of one adset, over
  /// a window. The unique index above already serves plain
  /// (dimension, date) filtering as its own prefix, so no second index for that.
  @@index([dimension, parent, date])
  @@map("marketing_daily")
}

/// Provenance for the whole import. Exactly one row, id = 'roistat'.
///
/// Every marketing screen has to say where its numbers came from and how stale
/// they are, and it must quote the BLOB's stamp rather than our Bitrix24 sync
/// stamp — they are different systems refreshed on different clocks, and
/// showing the wrong one is how a dashboard claims to be fresh while serving
/// three-day-old ad spend.
model MarketingSnapshot {
  /// Constant 'roistat'. One published dashboard, one row, no history table:
  /// the blob is a full replacement each time, not an increment.
  id        String @id
  sourceUrl String

  /// UZS per USD in micro units (1e6 per soʻm), as the blob states it:
  /// 11 823.69 is stored as 11 823 690 000.
  ///
  /// Micro rather than a Decimal because every UZS→USD figure on the module is
  /// derived from this one number, and a float rate applied to a BigInt total
  /// reintroduces exactly the drift the money contract exists to prevent.
  usdRateMicro BigInt
  /// The day that rate was taken, from `D.rateDate` ("27.08.2026").
  rateDate     DateTime @db.Date

  /// `D.updated` verbatim — "27.08.2026 14:11". A LABEL, not an instant.
  /// The blob names no timezone, so parsing it into a DateTime would force us
  /// to guess one and then render the guess as fact. The screens print the
  /// string the source printed.
  updatedLabel String

  /// `D.today` — the source's own idea of today, which is what its "Bugun"
  /// preset means. Not our clock: on a stale blob they differ, and the period
  /// control must clamp to the data, not to the wall.
  today     DateTime @db.Date
  /// `D.minDate` / `D.maxDate` — the clamp for every custom range.
  minDate   DateTime @db.Date
  maxDate   DateTime @db.Date
  /// `D.dailyFrom` — before this day the DAYS dimension holds monthly buckets,
  /// not days. The table renders those rows as "Iyul 2026 (oy)".
  dailyFrom DateTime @db.Date
  /// `D.freshFrom` — from this day the numbers are still settling (sales and
  /// cash close later), so the module shows the incomplete-period warning and
  /// marks those rows. A low ROAS there is normal, not a problem.
  freshFrom DateTime @db.Date

  /// Our clock: when the importer last ran successfully.
  importedAt DateTime @default(now())
  /// Rows written across all twelve dimensions in that run. The loud sanity
  /// check — a blob that suddenly carries a fraction of this is refused.
  rowCount   Int

  @@map("marketing_snapshot")
}

// ---------------------------------------------------------------------------
// KPI
// ---------------------------------------------------------------------------

model Kpi {
  id String @id @default(cuid())

  /// Null means the target belongs to the whole team rather than one person.
  employeeId String?
  metric     KpiMetric
  period     KpiPeriod

  /// Target value. Interpretation depends on `metric`:
  ///   REVENUE / AVERAGE_DEAL -> minor units
  ///   DEALS_CREATED / DEALS_WON -> a count
  ///   CONVERSION_RATE -> basis points (10000 = 100.00%)
  /// Stored as BigInt so money targets stay exact. See domain/kpi.
  targetValue BigInt

  periodStart DateTime
  periodEnd   DateTime
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee?   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  results  KpiResult[]

  @@unique([employeeId, metric, periodStart, periodEnd])
  @@index([metric])
  @@index([periodStart, periodEnd])
  @@index([isActive])
  @@map("kpi")
}

/// A computed snapshot of KPI attainment. The same numbers can be computed
/// live from deals; this table exists so historical attainment stays stable
/// after the underlying deals are edited or re-synced.
model KpiResult {
  id    String @id @default(cuid())
  kpiId String

  actualValue   BigInt
  /// Attainment in basis points (10000 = 100.00%). Integer, so no float drift.
  achievementBp Int
  status        KpiStatus

  computedAt DateTime @default(now())

  kpi Kpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([kpiId, computedAt])
  @@map("kpi_result")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

/// One row per sync run per entity. The audit trail for every import.
model SyncLog {
  id       String         @id @default(cuid())
  provider ExternalSource
  entity   SyncEntity
  mode     SyncMode
  status   SyncStatus     @default(RUNNING)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  recordsRead    Int @default(0)
  recordsCreated Int @default(0)
  recordsUpdated Int @default(0)
  recordsSkipped Int @default(0)
  recordsFailed  Int @default(0)

  /// Safe, already-redacted failure summary. Never a raw provider response:
  /// those can contain credentials.
  errorMessage String?

  @@index([provider, entity, startedAt])
  @@index([status])
  @@map("sync_log")
}

/// Incremental sync bookmark: where to resume from per provider+entity.
model SyncCursor {
  id       String         @id @default(cuid())
  provider ExternalSource
  entity   SyncEntity

  /// Watermark for "give me everything changed since". Compared against the
  /// source's own updated-at, never against our row timestamps.
  lastSyncedAt   DateTime?
  lastExternalId String?

  updatedAt DateTime @updatedAt

  @@unique([provider, entity])
  @@map("sync_cursor")
}

model AuditLog {
  id          String  @id @default(cuid())
  actorUserId String?
  action      String
  entity      String
  entityId    String?
  /// Structured before/after diff. Must be redacted before it is written.
  changes     Json?
  ipAddress   String?
  userAgent   String?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
