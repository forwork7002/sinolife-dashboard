.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# A hand-built production tree (`next build --distDir .next-prod`, served
# beside the dev server). It MUST be ignored, and not only to keep 231 MB
# out of a commit: Tailwind v4's automatic source detection skips what git
# ignores and scans everything else, so while this tree was tracked it read
# the binary Turbopack cache inside it as candidate class names. That put
# `.pt-\[max\(env\(w\17 Q-areaL...` into the generated stylesheet and every
# page 500'd on `Parsing CSS source code failed` — from a file nobody edited.
/.next-prod/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

