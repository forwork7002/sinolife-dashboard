# =============================================================================
# SinoLife Sales Intelligence — environment template
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# Every variable here is validated at boot by src/server/config/env.ts —
# the app refuses to start on a bad value rather than failing later at runtime.
#
# Only variables prefixed NEXT_PUBLIC_ are readable by the browser.
# Everything else is server-only and must never be imported into a client
# component. That boundary is enforced by lint rules, not just by convention.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# A password containing special characters must be URL-encoded.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/sinolife?schema=public"

# -----------------------------------------------------------------------------
# Data source
# -----------------------------------------------------------------------------
# Which CRM provider feeds the synchronisation engine.
#   demo     — deterministic generated data (no credentials required)
#   bitrix24 — the real Bitrix24 account
#
# This is the ONLY switch. It is read once, in src/server/config/providerFactory.ts.
# Nothing else in the codebase may branch on it.
DATA_SOURCE=demo

# Seed for the deterministic demo generator. The same seed always produces the
# same employees, deals and revenue, so the dashboard never shifts between runs.
DEMO_SEED=20260101

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates every existing session.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Localisation
# -----------------------------------------------------------------------------
# IANA timezone used for every period boundary. Asia/Tashkent is UTC+5 with no
# daylight saving. Changing this changes what "this month" means everywhere.
APP_TIMEZONE=Asia/Tashkent
APP_DEFAULT_LOCALE=uz
APP_DEFAULT_CURRENCY=UZS

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# =============================================================================
# Bitrix24 — BITRIX24_INTEGRATION_PENDING
#
# Leave these EMPTY until the real credentials are issued. The application runs
# fully without them while DATA_SOURCE=demo.
#
# Setting DATA_SOURCE=bitrix24 without a webhook URL is a startup error, by
# design: a half-configured integration must fail loudly, not fall back to demo
# data and present it as live.
#
# The webhook URL embeds an access token. It is a secret. Never commit it,
# never log it, never send it to the browser.
# =============================================================================

# Inbound webhook, e.g. https://<portal>.bitrix24.ru/rest/<user-id>/<token>/
BITRIX24_WEBHOOK_URL=

# Client-side throttle. Bitrix24 enforces roughly 2 requests/second per portal;
# staying under it is our responsibility, not theirs.
BITRIX24_RATE_LIMIT_RPS=2
BITRIX24_REQUEST_TIMEOUT_MS=15000
BITRIX24_MAX_RETRIES=3
