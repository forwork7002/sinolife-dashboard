# =============================================================================
# SinoLife Sales Intelligence — environment template
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# Every variable here is validated at boot by src/server/config/env.ts —
# the app refuses to start on a bad value rather than failing later at runtime.
#
# Only variables prefixed NEXT_PUBLIC_ are readable by the browser.
# Everything else is server-only and must never be imported into a client
# component. That boundary is enforced by lint rules, not just by convention.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# A password containing special characters must be URL-encoded.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/sinolife?schema=public"

# -----------------------------------------------------------------------------
# Data source
# -----------------------------------------------------------------------------
# Which CRM provider feeds the synchronisation engine.
#   bitrix24 — the real Bitrix24 account. The only value used in production.
#   demo     — the deterministic generator, kept for tests and offline work.
#
# This is the ONLY switch. It is read once, in src/server/config/providerFactory.ts.
# Nothing else in the codebase may branch on it.
DATA_SOURCE=bitrix24

# Seed for the deterministic demo generator. Irrelevant under bitrix24.
DEMO_SEED=20260101

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates every existing session.
#
# On a hosting platform this is the ONLY variable here you must set by hand:
# a session-signing secret cannot be derived from anything public, and one
# generated at startup would sign everyone out on the next cold start.
BETTER_AUTH_SECRET=
#
# The two URLs below are needed locally. On Vercel and Netlify they are filled
# in from the platform's own deployment URL when left unset, so you can leave
# them out entirely there — set them only to pin a custom domain.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# The administrator account
# -----------------------------------------------------------------------------
# This deployment has exactly ONE login, provisioned by:
#
#     npm run db:seed:users
#
# Public sign-up is disabled in code, so this is the only way an account comes
# into existence. Keep the password out of the repository and out of chat — set
# it in the hosting platform's secret store and nowhere else.
#
# Minimum 12 characters; the seed refuses anything shorter. Change it after the
# first login is confirmed working:
#
#     npm run db:seed:users -- --reset-password
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Extra trusted origins
# -----------------------------------------------------------------------------
# Comma-separated, e.g. https://dash.example.uz,https://www.example.uz
#
# better-auth refuses a sign-in whose Origin header is not trusted — that is
# what stops another site posting to our endpoints with your cookies. It
# already trusts BETTER_AUTH_URL, and an http deployment also trusts loopback
# and this machine's own LAN addresses on the same port, so opening the app at
# 127.0.0.1 or by IP works without configuration.
#
# Set this only for an address neither of those covers: a reverse proxy, or a
# second domain pointing at the same app. Anything listed here is trusted
# verbatim.
APP_TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# Localisation
# -----------------------------------------------------------------------------
# IANA timezone used for every period boundary. Asia/Tashkent is UTC+5 with no
# daylight saving. Changing this changes what "this month" means everywhere.
APP_TIMEZONE=Asia/Tashkent
APP_DEFAULT_LOCALE=uz
APP_DEFAULT_CURRENCY=UZS

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# =============================================================================
# Bitrix24 — BITRIX24_INTEGRATION_PENDING
#
# Leave these EMPTY until the real credentials are issued. The application runs
# fully without them while DATA_SOURCE=demo.
#
# Setting DATA_SOURCE=bitrix24 without a webhook URL is a startup error, by
# design: a half-configured integration must fail loudly, not fall back to demo
# data and present it as live.
#
# The webhook URL embeds an access token. It is a secret. Never commit it,
# never log it, never send it to the browser.
# =============================================================================

# Inbound webhook, e.g. https://<portal>.bitrix24.kz/rest/<user-id>/<token>/
#
# The webhook needs these permissions, set in the Bitrix24 UI at
# Приложения → Разработчикам → Входящий вебхук → Права доступа:
#
#   crm                  deals, contacts, products, stage history   (required)
#   user, department     employees and the company tree             (required)
#   telephony            call records                               (call module)
#   catalog              purchase prices and stores                 (margin module)
#   task, timeman        workload and attendance                    (planned)
#
# Editing the permissions does NOT change the URL, so this value survives it.
BITRIX24_WEBHOOK_URL=

# Client-side throttle. Bitrix24 enforces roughly 2 requests/second per portal;
# staying under it is our responsibility, not theirs.
BITRIX24_RATE_LIMIT_RPS=2
BITRIX24_REQUEST_TIMEOUT_MS=30000
BITRIX24_MAX_RETRIES=3

# How many months of telephony to import.
#
# The portal logs roughly 12 400 calls a DAY, so a year is 4.5 million rows for
# a question nobody asks. One month is ~370 000 rows and about fifteen minutes;
# incremental syncs afterwards add a day at a time.
BITRIX24_CALL_MONTHS=1
